# Copy this to .env and fill in your values
# Never commit .env to git

# Public R2 origin (no trailing slash)
PUBLIC_R2_PUBLIC_BASE_URL=https://media.stokeleads.com

# Folder inside the bucket for this client. Relative paths passed to r2img() use it.
PUBLIC_R2_SITE_SLUG=faberroof

# Deployed site URL (sitemap, canonical, JSON-LD)
SITE_URL=https://faberroof.com

DATAFORSEO_LOGIN=your_login
DATAFORSEO_PASSWORD=your_password

# Reviews sync (npm run sync-reviews or npm run build:sync)
# SKIP_SYNC_REVIEWS=1
# SYNC_REVIEWS_DEBUG=1
# Put the decimal Google CID in scripts/reviews-clients.json (string, not a Maps feature id).

# --- Lead forms (Cloudflare Pages Function: functions/api/lead.ts) ---
# Set these as encrypted secrets in Cloudflare Pages. Do not commit them.
# GHL_WEBHOOK_URL=
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# LEAD_SOURCE=website
