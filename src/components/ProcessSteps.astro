---
import { SITE } from '../config/site';

const process = SITE.process;
---

<section id="process" class="section process">
  <div class="container">
    <p class="section-label">{process.label}</p>
    <h2>{process.title}</h2>
    {process.subtitle && <p class="subtext process__intro">{process.subtitle}</p>}

    <ol class="process__steps">
      {process.steps.map((step: { title: string; description: string }, index: number) => (
        <li>
          <span class="process__num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--deep);
    color: rgba(255, 250, 245, 0.78);
  }

  .process .section-label {
    color: var(--gold);
  }

  .process h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(2.35rem, 5vw, 3.85rem);
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
  }

  .process__intro {
    margin-bottom: 2rem;
    color: rgba(255, 250, 245, 0.72);
  }

  .process__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .process__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .process__steps li {
    padding-top: 0.85rem;
    border-top: 2px solid color-mix(in srgb, var(--gold) 72%, transparent);
  }

  .process__num {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--gold);
  }

  .process__steps h3 {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  .process__steps p {
    margin: 0;
    max-width: none;
    font-size: 0.95rem;
    color: rgba(255, 250, 245, 0.74);
  }
</style>
