---
import { SITE } from '../config/site';

const cta = SITE.ctaBanner;
const telHref = `tel:${(SITE.phoneDisplay ?? SITE.phone).replace(/\D/g, '')}`;
---

<section class="cta-banner">
  <div class="cta-banner__wash" aria-hidden="true"></div>
  <div class="container cta-banner__inner">
    <div class="cta-banner__text">
      <h2>{cta.title}</h2>
      <p class="cta-banner__subtitle">{cta.subtitle}</p>
      <p>{cta.body}</p>
    </div>
    <div class="cta-banner__actions">
      <a href={cta.scheduleHref} class="cta-banner__btn cta-banner__btn--schedule">
        <span class="cta-banner__btn-main">{cta.scheduleLabel}</span>
        <span class="cta-banner__btn-sub">{cta.scheduleSub}</span>
      </a>
      <a href={telHref} class="cta-banner__btn cta-banner__btn--call">
        <span class="cta-banner__btn-main">
          <i class="fas fa-phone" aria-hidden="true"></i>
          {SITE.phone}
        </span>
        <span class="cta-banner__btn-sub">{cta.callSub}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    overflow: hidden;
    background: var(--deep);
    padding: 4.25rem 0;
    color: #fff;
  }

  .cta-banner__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 100% 0%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 55%),
      radial-gradient(ellipse 50% 70% at 0% 100%, rgba(255, 255, 255, 0.06), transparent 50%);
    pointer-events: none;
  }

  .cta-banner__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta-banner__text h2 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.95;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .cta-banner__subtitle {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    font-weight: 600;
    margin: 0 0 0.65rem;
    max-width: 36rem;
  }

  .cta-banner__text p:last-child {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    max-width: 34rem;
    margin: 0;
  }

  .cta-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
    max-width: 28rem;
  }

  .cta-banner__btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 1rem 1.35rem;
    border-radius: 4px;
    text-decoration: none;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .cta-banner__btn:hover {
    transform: translateY(-1px);
  }

  .cta-banner__btn--schedule {
    background: var(--accent);
    color: #fff;
  }

  .cta-banner__btn--schedule:hover {
    background: var(--accent-hover);
    color: #fff;
  }

  .cta-banner__btn--call {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .cta-banner__btn--call:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .cta-banner__btn-main {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
  }

  .cta-banner__btn-sub {
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.85;
  }

  @media (min-width: 900px) {
    .cta-banner__inner {
      flex-direction: row;
      align-items: center;
      gap: 3rem;
    }

    .cta-banner__text {
      flex: 1;
    }

    .cta-banner__actions {
      width: min(22rem, 40%);
      max-width: none;
    }
  }
</style>
