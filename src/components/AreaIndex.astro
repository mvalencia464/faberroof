---
interface AreaLink {
  name: string;
  slug: string;
  county?: string;
}

interface Props {
  areas: AreaLink[];
  grouped?: boolean;
  /** Single column, for sidebars */
  stack?: boolean;
}

const { areas, grouped = false, stack = false } = Astro.props;

const counties = [...new Set(areas.map((area) => area.county).filter(Boolean))] as string[];

const groups = grouped
  ? counties.map((county) => ({
      county,
      areas: areas.filter((area) => area.county === county),
    }))
  : [{ county: '', areas }];
---

<div class:list={['area-index', stack && 'area-index--stack']}>
  {groups.map((group) => (
    <div class="area-index__group">
      {group.county && <p class="area-index__county">{group.county} County</p>}
      <ul>
        {group.areas.map((area) => (
          <li>
            <a href={`/areas/${area.slug}`}>
              <span>{area.name}</span>
              <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .area-index__group + .area-index__group {
    margin-top: 1.15rem;
  }

  .area-index__county {
    margin: 0 0 0.45rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .area-index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }

  .area-index a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.7rem 0.85rem;
    background: #fffdfb;
    border: 1px solid var(--border);
    border-left: 2px solid var(--gold);
    color: var(--deep);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.2;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .area-index a i {
    color: var(--accent);
    font-size: 0.68rem;
    flex-shrink: 0;
  }

  .area-index a:hover {
    background: var(--panel);
    border-color: color-mix(in srgb, var(--gold) 45%, var(--border));
    border-left-color: var(--gold);
  }

  .area-index--stack a {
    padding: 0.5rem 0.7rem;
    font-size: 0.88rem;
  }

  @media (min-width: 640px) {
    .area-index:not(.area-index--stack) ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
