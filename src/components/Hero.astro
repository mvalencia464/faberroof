---
/**
 * Homepage hero
 */
import { SITE } from '../config/site';
import { syncedReviewMeta } from '../data/all-reviews';
import GoogleMark from './GoogleMark.astro';

const hero = SITE.hero;
const heroSrc = hero.image;
const heroSrcSm = hero.imageSm ?? hero.image;
const rating = syncedReviewMeta.rating || SITE.googleReviews.rating;
const count = syncedReviewMeta.count || SITE.googleReviews.count;

/** Phosphor duotone. https://github.com/phosphor-icons/core (MIT) */
const outlineIcons: Record<string, string> = {
  home: '<svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M216,120v96H152V152H104v64H40V120a8,8,0,0,1,2.34-5.66l80-80a8,8,0,0,1,11.32,0l80,80A8,8,0,0,1,216,120Z" opacity="0.2"/><path d="M219.31,108.68l-80-80a16,16,0,0,0-22.62,0l-80,80A15.87,15.87,0,0,0,32,120v96a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V160h32v56a8,8,0,0,0,8,8h64a8,8,0,0,0,8-8V120A15.87,15.87,0,0,0,219.31,108.68ZM208,208H160V152a8,8,0,0,0-8-8H104a8,8,0,0,0-8,8v56H48V120l80-80,80,80Z"/></svg>',
  building:
    '<svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M136,32V216H40V85.35a8,8,0,0,1,3.56-6.66l80-53.33A8,8,0,0,1,136,32Z" opacity="0.2"/><path d="M240,208H224V96a16,16,0,0,0-16-16H144V32a16,16,0,0,0-24.88-13.32L39.12,72A16,16,0,0,0,32,85.34V208H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16ZM208,96V208H144V96ZM48,85.34,128,32V208H48ZM112,112v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm-32,0v16a8,8,0,0,1-16,0V112a8,8,0,1,1,16,0Zm0,56v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Zm32,0v16a8,8,0,0,1-16,0V168a8,8,0,0,1,16,0Z"/></svg>',
  'clipboard-list':
    '<svg viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path d="M95.8,56.2a28,28,0,1,1-39.6,0A28,28,0,0,1,95.8,56.2Zm104,104a28,28,0,1,0,0,39.6A28,28,0,0,0,199.8,160.2Z" opacity="0.2"/><path d="M205.66,61.64l-144,144a8,8,0,0,1-11.32-11.32l144-144a8,8,0,0,1,11.32,11.31ZM50.54,101.44a36,36,0,0,1,50.92-50.91h0a36,36,0,0,1-50.92,50.91ZM56,76A20,20,0,1,0,90.14,61.84h0A20,20,0,0,0,56,76ZM216,180a36,36,0,1,1-10.54-25.46h0A35.76,35.76,0,0,1,216,180Zm-16,0a20,20,0,1,0-5.86,14.14A19.87,19.87,0,0,0,200,180Z"/></svg>',
};
---

<section class="hero-js">
  <div class="hero-js__bg" aria-hidden="true">
    <picture>
      <source
        media="(max-width: 767px)"
        srcset={heroSrcSm}
        type="image/avif"
        width="960"
        height="540"
      />
      <img
        src={heroSrc}
        alt={SITE.heroImageAlt}
        class="hero-js__bg-img"
        width="1920"
        height="1080"
        sizes="100vw"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-js__overlay"></div>
  </div>

  <div class="container hero-js__content">
    <div class="hero-js__copy">
      <a class="hero-js__chip" href="/#reviews">
        <span class="hero-js__chip-stars" aria-hidden="true">
          <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
        </span>
        <span class="hero-js__chip-mark" aria-hidden="true">
          <GoogleMark size="0.7rem" />
        </span>
        <span>
          {count > 0
            ? `${rating.toFixed(1)} Rating · ${count} Google Reviews`
            : 'Google Reviews'}
        </span>
      </a>

      <h1 class="hero-js__headline">
        <span class="hero-js__line1">{hero.headingLine1}</span>
        <br />
        <span class="hero-js__accent">
          {hero.headingAccent}<span class="hero-js__dot">.</span>
        </span>
      </h1>

      <p class="hero-js__sub">{hero.subheading}</p>

      <div class="hero-js__benefits">
        {
          hero.benefits.map((b) => (
            <div class="hero-js__benefit">
              <span class="hero-js__benefit-icon" set:html={outlineIcons[b.icon] ?? ''} />
              <span
                class="hero-js__benefit-label"
                set:html={
                  b.icon === 'star'
                    ? `${rating.toFixed(1)} Rating<br />${count} Reviews`
                    : b.label.replace('\n', '<br />')
                }
              />
            </div>
          ))
        }
      </div>

      <p class="hero-js__note">{hero.financingNote}</p>

      <div class="hero-js__actions">
        <a class="btn btn--primary" href={hero.ctaCommercialHref}>{hero.ctaCommercial}</a>
        <a class="btn hero-js__residential" href={hero.ctaResidentialHref}>{hero.ctaResidential}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-js {
    position: relative;
    min-height: min(100vh, 50rem);
    display: flex;
    align-items: center;
    padding: 8.25rem 0 5rem;
    overflow: hidden;
    color: #fff;
    background: var(--deep);
  }

  .hero-js__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-js__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-js__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--deep) 92%, #000) 0%,
        color-mix(in srgb, var(--deep) 74%, transparent) 42%,
        color-mix(in srgb, var(--deep) 16%, transparent) 100%
      );
  }

  .hero-js__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .hero-js__copy {
    max-width: 40rem;
    text-align: left;
  }

  .hero-js__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.35rem;
  }

  .hero-js__residential {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.55);
  }

  .hero-js__residential:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  .hero-js__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1.05rem;
    padding: 0.28rem 0.7rem 0.28rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--gold) 42%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--deep) 42%, transparent);
    color: rgba(241, 245, 249, 0.95);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .hero-js__chip-stars {
    color: var(--gold);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
  }

  .hero-js__chip-mark {
    width: 0.7rem;
    height: 0.7rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-js__chip-mark :global(svg) {
    width: 0.7rem !important;
    height: 0.7rem !important;
  }

  .hero-js__headline {
    margin: 0 0 0.9rem;
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 5.4vw, 3.65rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.25);
  }

  .hero-js__line1 {
    white-space: normal;
  }

  .hero-js__accent,
  .hero-js__dot {
    color: var(--gold, #e0a100);
    font-weight: 600;
  }

  .hero-js__sub {
    margin: 0 0 1.65rem;
    max-width: 32rem;
    font-size: clamp(0.98rem, 1.7vw, 1.12rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: rgba(226, 232, 240, 0.9);
  }

  .hero-js__benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.1rem;
    max-width: 30rem;
    margin-bottom: 1.85rem;
  }

  .hero-js__benefit {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    text-align: left;
  }

  .hero-js__benefit-icon {
    flex-shrink: 0;
    width: 2.7rem;
    height: 2.7rem;
    border: 1.5px solid var(--gold, #e0a100);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--gold, #e0a100);
    background: color-mix(in srgb, var(--gold, #e0a100) 18%, transparent);
  }

  .hero-js__benefit-icon :global(svg) {
    width: 1.7rem;
    height: 1.7rem;
  }

  .hero-js__benefit-icon :global([opacity]) {
    opacity: 0.45;
  }

  .hero-js__benefit-label {
    font-family: var(--font-body);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.35;
    color: rgba(241, 245, 249, 0.95);
    padding-top: 0.15rem;
  }

  .hero-js__note {
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    color: rgba(226, 232, 240, 0.78);
    max-width: none;
  }

  @media (max-width: 640px) {
    .hero-js {
      min-height: auto;
      padding: 6.5rem 0 3.5rem;
    }

    .hero-js__bg-img {
      object-position: right 30%;
    }

    .hero-js__overlay {
      background: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--deep) 94%, #000) 0%,
        color-mix(in srgb, var(--deep) 82%, transparent) 55%,
        color-mix(in srgb, var(--deep) 62%, transparent) 100%
      );
    }

    .hero-js__line1 {
      white-space: normal;
    }

    .hero-js__benefits {
      gap: 0.85rem 0.65rem;
    }

    .hero-js__benefit {
      flex-direction: column;
      gap: 0.4rem;
    }
  }
</style>
