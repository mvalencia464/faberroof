---
import { SITE } from '../config/site';
import { JOBS } from '../data/jobs';
import { r2img } from '../lib/r2';

const gallery = SITE.workGallery;
const jobs = JOBS.slice(0, 8);

const pad = (n: number) => String(n + 1).padStart(2, '0');
---

{jobs.length > 0 && (
<section id="work" class="section recent-jobs">
  <div class="container">
    <div class="recent-jobs__header">
      <p class="section-label">{gallery.label}</p>
      <h2>{gallery.title}</h2>
      <p class="subtext">{gallery.intro}</p>
    </div>

    <div class="recent-jobs__grid">
      {
        jobs.map((job, i) => (
          <a href={`/jobs/${job.slug}`} class="work-card" data-service={job.serviceSlug}>
            <div class="work-card__media">
              <img
                src={r2img(job.cover)}
                alt={`${job.serviceLabel} in ${job.city}, ${SITE.state}`}
                loading="lazy"
                decoding="async"
                width="640"
                height="480"
              />
              <span class="work-card__city">{job.city}, {SITE.state}</span>
            </div>
            <span class="work-card__meta">
              <span class="work-card__index">{pad(i)}</span>
              <span class="work-card__service">{job.serviceLabel}</span>
            </span>
            <span class="work-card__body">
              <strong>{job.title}</strong>
              <span class="work-card__hook">{job.caption}</span>
              <span class="work-card__link">
                See this job
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
)}

<style is:global>
  .recent-jobs {
    background: var(--surface);
  }

  .recent-jobs__header {
    margin-bottom: 2.25rem;
    max-width: 40rem;
  }

  .recent-jobs__header h2 {
    color: var(--deep);
    margin-bottom: 0.65rem;
  }

  .recent-jobs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  @media (min-width: 640px) {
    .recent-jobs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .recent-jobs__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #work .work-card {
    --job-accent: var(--accent);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: 0 8px 24px rgba(10, 25, 47, 0.06);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #work .work-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 28px rgba(10, 25, 47, 0.1);
  }

  #work .work-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
  }

  #work .work-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #work .work-card:hover .work-card__media img {
    transform: scale(1.05);
  }

  #work .work-card__city {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    background: rgba(10, 25, 47, 0.78);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #work .work-card__meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 1.05rem;
    background: var(--job-accent);
    color: #fff;
  }

  #work .work-card__index {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    opacity: 0.85;
  }

  #work .work-card__service {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #work .work-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.05rem 1.15rem 1.2rem;
    flex: 1;
  }

  #work .work-card__body strong {
    color: var(--deep);
    font-size: 1.05rem;
    line-height: 1.25;
  }

  #work .work-card__hook {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  #work .work-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.45rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--job-accent);
  }

  #work .work-card:hover .work-card__link {
    filter: brightness(0.88);
  }
</style>
