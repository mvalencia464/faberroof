---
import { SITE, AREA_PAGES } from '../config/site';
import LazyGoogleMap from './LazyGoogleMap.astro';

const mapTitle = `${SITE.name} — ${SITE.map.radiusMiles}-mile service area around ${SITE.city}, ${SITE.state}`;

/** Map display names → area page slugs */
const areaByName: Record<string, string> = {
  ...Object.fromEntries(AREA_PAGES.map((a) => [a.name, a.slug])),
};
---

<section id="service-areas" class="section section--alt service-area">
  <div class="container service-area__inner">
    <div class="service-area__copy">
      <p class="section-label">Service Map</p>
      <h2>{SITE.serviceArea.heading}</h2>
      <p>{SITE.serviceArea.body}</p>
      <div class="service-area__labels" role="list">
        {SITE.serviceAreas.map((city) => {
          const slug = areaByName[city];
          return slug ? (
            <a class="service-area__label" role="listitem" href={`/areas/${slug}`}>{city}</a>
          ) : (
            <span class="service-area__label" role="listitem">{city}</span>
          );
        })}
      </div>
      {SITE.map.radiusMiles > 0 && (
        <p class="service-area__radius">
          Within {SITE.map.radiusMiles} miles of {SITE.city}, {SITE.state}
        </p>
      )}
      {SITE.map.listingUrl && (
        <a
          class="service-area__maps-link"
          href={SITE.map.listingUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Open in Google Maps →
        </a>
      )}
    </div>
    <div class="service-area__map-wrap">
      <LazyGoogleMap title={mapTitle} />
    </div>
  </div>
</section>

<style>
  .service-area__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .service-area__copy h2 {
    color: var(--deep);
    margin-bottom: 1rem;
  }

  .service-area__copy > p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 42ch;
    margin-bottom: 1.25rem;
  }

  .service-area__labels {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1.15rem;
    max-width: 36rem;
  }

  .service-area__label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1.05rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--deep);
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 3px;
    white-space: nowrap;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  a.service-area__label:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .service-area__radius {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--deep);
    margin-bottom: 0.75rem;
  }

  .service-area__maps-link {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .service-area__map-wrap {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 900px) {
    .service-area__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 3rem;
    }
  }
</style>
