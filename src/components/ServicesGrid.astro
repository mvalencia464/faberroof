---
import { SITE } from '../config/site';
import { r2img } from '../lib/r2';

const primarySlugs = SITE.servicesPrimary ?? SITE.services.map((s) => s.slug);

const services = primarySlugs
  .map((slug) => SITE.services.find((service) => service.slug === slug))
  .filter((service): service is (typeof SITE.services)[number] => Boolean(service));

const iconClass: Record<string, string> = {
  snowflake: 'fa-snowflake',
  fire: 'fa-fire',
  tools: 'fa-tools',
  'house-chimney': 'fa-house-chimney',
  wind: 'fa-wind',
  home: 'fa-home',
  building: 'fa-building',
  'clipboard-list': 'fa-clipboard-list',
};
---

<section id="services" class="section services-section">
  <div class="container">
    <div class="services-section__header">
      <p class="section-label">{SITE.servicesLabel}</p>
      <h2>{SITE.servicesHeading}</h2>
      <p class="subtext">{SITE.servicesIntro}</p>
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <div class="service-card__visual">
              <a href={`/services/${service.slug}`} class="service-card__media">
                <img
                  src={r2img(service.image)}
                  alt={service.title}
                  loading="lazy"
                  decoding="async"
                  width="640"
                  height="420"
                />
              </a>
              <span class={`service-card__icon service-card__icon--${service.iconStyle}`}>
                <i class={`fas ${iconClass[service.icon] ?? 'fa-check'}`} aria-hidden="true" />
              </span>
            </div>
            <div class="service-card__body">
              <h3>
                <a href={`/services/${service.slug}`}>{service.title}</a>
              </h3>
              <p>{service.shortDesc}</p>
              <a href={`/services/${service.slug}`} class="service-card__link">
                See {service.title.toLowerCase()}
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    background: #fff;
  }

  .services-section__header {
    text-align: center;
    margin-bottom: 2.75rem;
  }

  .services-section__header h2 {
    color: var(--deep);
    margin-bottom: 0.75rem;
  }

  .services-section__header .subtext {
    margin: 0 auto;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(10, 25, 47, 0.06);
    display: flex;
    flex-direction: column;
  }

  .service-card__visual {
    position: relative;
    overflow: visible;
  }

  .service-card__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--panel);
    border-radius: 10px 10px 0 0;
  }

  .service-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service-card__icon {
    position: absolute;
    left: 1rem;
    bottom: 0;
    z-index: 1;
    transform: translateY(50%);
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: var(--deep);
    box-shadow: 0 6px 16px rgba(10, 25, 47, 0.25);
  }

  .service-card__icon--red {
    background: #c2410c;
  }

  .service-card__body {
    padding: 1.85rem 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .service-card__body h3 {
    margin: 0;
    font-size: 1.15rem;
    color: var(--deep);
  }

  .service-card__body h3 a {
    color: inherit;
    text-decoration: none;
  }

  .service-card__body p {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
    max-width: none;
    flex: 1;
  }

  .service-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    text-decoration: none;
  }

  .service-card__link:hover {
    color: var(--accent-hover);
  }
</style>
