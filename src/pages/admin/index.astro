---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { buildSiteAssets, type AssetCategory } from '../../data/site-assets';

const assets = buildSiteAssets();

const categories: { id: 'all' | AssetCategory; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'brand', label: 'Brand' },
  { id: 'marketing', label: 'Marketing' },
  { id: 'service', label: 'Services' },
  { id: 'gallery', label: 'Gallery' },
];
---

<BaseLayout
  title={`Asset library | ${SITE.name}`}
  description="Internal image asset library. Not indexed."
  noindex={true}
  hideMobileCta={true}
>
  <div class="admin">
    <header class="admin__header">
      <div class="admin__header-inner">
        <div>
          <p class="admin__eyebrow">Internal · noindex</p>
          <h1>Asset library</h1>
          <p class="admin__lead">
            {assets.length} images from {SITE.name} config and media. Click a card to copy the URL.
          </p>
        </div>
        <a href="/" class="admin__home-link">← Back to site</a>
      </div>
    </header>

    <main class="admin__main">
      <div class="admin__filters" role="tablist" aria-label="Filter by category">
        {categories.map((cat) => (
          <button
            type="button"
            class="admin__filter"
            data-filter={cat.id}
            aria-pressed={cat.id === 'all' ? 'true' : 'false'}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <p class="admin__toast" id="copy-toast" hidden aria-live="polite">URL copied</p>

      <ul class="admin__grid" id="asset-grid">
        {assets.map((asset) => (
          <li class="admin__card" data-category={asset.category}>
            <button type="button" class="admin__card-btn" data-url={asset.url} title="Copy image URL">
              <div class="admin__thumb-wrap">
                <img src={asset.url} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="admin__card-body">
                <span class={`admin__badge admin__badge--${asset.category}`}>{asset.category}</span>
                <h2>{asset.label}</h2>
                <p class="admin__used">
                  {asset.usedIn.join(' · ')}
                </p>
                <code class="admin__url">{asset.url}</code>
              </div>
            </button>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>

<script>
  const grid = document.getElementById('asset-grid');
  const toast = document.getElementById('copy-toast');
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.admin__filter');

  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  function showToast() {
    if (!toast) return;
    toast.hidden = false;
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => {
      toast.hidden = true;
    }, 2000);
  }

  grid?.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.admin__card-btn');
    if (!btn?.dataset.url) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.url);
      showToast();
    } catch {
      window.prompt('Copy URL:', btn.dataset.url);
    }
  });

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'all';
      filterButtons.forEach((b) => {
        b.setAttribute('aria-pressed', b === button ? 'true' : 'false');
      });
      grid?.querySelectorAll<HTMLElement>('.admin__card').forEach((card) => {
        const match = filter === 'all' || card.dataset.category === filter;
        card.hidden = !match;
      });
    });
  });
</script>

<style>
  .admin {
    min-height: 100vh;
    background: var(--deep);
    color: var(--text);
  }

  .admin__header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    padding: 1.5rem 1.25rem;
  }

  .admin__header-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .admin__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent2);
    margin-bottom: 0.35rem;
  }

  .admin__header h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin-bottom: 0.35rem;
  }

  .admin__lead {
    color: var(--muted);
    max-width: 52ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .admin__home-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .admin__home-link:hover {
    color: var(--accent2);
  }

  .admin__main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .admin__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .admin__filter {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel);
    color: var(--muted);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }

  .admin__filter[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--text);
    background: rgba(64, 145, 108, 0.2);
  }

  .admin__toast {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--panel2);
    border: 1px solid var(--accent);
    color: var(--text);
    padding: 0.6rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    z-index: 100;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
  }

  .admin__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .admin__card {
    margin: 0;
  }

  .admin__card-btn {
    width: 100%;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel);
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }

  .admin__card-btn:hover {
    border-color: rgba(64, 145, 108, 0.55);
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.28);
  }

  .admin__thumb-wrap {
    aspect-ratio: 4 / 3;
    background: var(--surface);
    overflow: hidden;
  }

  .admin__thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .admin__card-body {
    padding: 0.85rem 1rem 1rem;
  }

  .admin__badge {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.45rem;
    border-radius: 4px;
    margin-bottom: 0.45rem;
    background: rgba(64, 145, 108, 0.15);
    color: #95d5b2;
  }

  .admin__card-body h2 {
    font-size: 0.95rem;
    line-height: 1.35;
    margin-bottom: 0.35rem;
    color: var(--text);
  }

  .admin__used {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.45;
    margin-bottom: 0.5rem;
  }

  .admin__url {
    display: block;
    font-size: 0.68rem;
    color: rgba(220, 235, 225, 0.45);
    word-break: break-all;
    line-height: 1.4;
  }
</style>
