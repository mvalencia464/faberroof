---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTABanner from '../components/CTABanner.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { SITE } from '../config/site';
import { allGoogleReviews } from '../data/all-reviews';

const page = SITE.reviewsPage;
const google = SITE.googleReviews;
const reviews = allGoogleReviews;
const telHref = `tel:${(SITE.phoneDisplay ?? SITE.phone).replace(/\D/g, '')}`;
---

<BaseLayout
  title={`${page.title} | ${SITE.name}`}
  description={page.description}
>
  <Header />

  <main>
    <section class="reviews-page-hero">
      <div class="container reviews-page-hero__inner">
        <a href="/#reviews" class="reviews-page-hero__back">← Back to homepage reviews</a>
        <p class="section-label">{page.label}</p>
        <h1>{page.title}</h1>
        <p class="reviews-page-hero__subtitle">{page.subtitle}</p>

        <div class="reviews-page-hero__summary">
          <div class="reviews-page-hero__brand" aria-hidden="true">
            <span class="reviews-page-hero__g">G</span>
            <span class="reviews-page-hero__stars">
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
              <i class="fas fa-star"></i>
            </span>
          </div>
          <div>
            <strong>{google.rating} out of 5</strong>
            <span>Based on {google.count.toLocaleString()} Google reviews</span>
          </div>
          <a
            href={google.profileUrl}
            class="btn btn--outline reviews-page-hero__profile"
            target="_blank"
            rel="noopener noreferrer"
          >
            View on Google Maps
          </a>
        </div>
      </div>
    </section>

    <section class="section reviews-page-list">
      <div class="reviews-page-list__pattern" aria-hidden="true"></div>
      <div class="container reviews-page-list__inner">
        <p class="reviews-page-list__count">
          Showing {reviews.length} recent Google reviews
        </p>
        <div class="reviews-page-grid">
          {reviews.map((review) => (
            <div class="reviews-page-cell">
              <ReviewCard review={review} showGoogleLink />
            </div>
          ))}
        </div>

        <div class="reviews-page-cta panel-card">
          <h2>Ready for cool air you can count on?</h2>
          <p>Join homeowners across {SITE.city} and {SITE.region} who got help when their AC quit.</p>
          <div class="reviews-page-cta__actions">
            <a href={telHref} class="btn btn--primary">Call {SITE.phone}</a>
            <a href="/contact" class="btn btn--outline">{SITE.ctaPrimaryLabel}</a>
            <a
              href={google.profileUrl}
              class="btn btn--ghost"
              target="_blank"
              rel="noopener noreferrer"
            >
              Leave a Google Review
            </a>
          </div>
        </div>
      </div>
    </section>

    <CTABanner />
  </main>

  <Footer />
</BaseLayout>

<style>
  .reviews-page-hero {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--deep) 8%, #fff) 0%,
      #fff 55%
    );
    border-bottom: 1px solid var(--border);
    padding-block: 6rem 3rem;
  }

  .reviews-page-hero__back {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    margin-bottom: 1.25rem;
    text-decoration: none;
  }

  .reviews-page-hero__back:hover {
    color: var(--accent);
  }

  .reviews-page-hero__inner h1 {
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    line-height: 0.95;
    color: var(--deep);
    margin-bottom: 0.75rem;
    max-width: 14ch;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .reviews-page-hero__subtitle {
    color: var(--muted);
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.65;
    max-width: 32.5rem;
    margin-bottom: 2rem;
  }

  .reviews-page-hero__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(19, 40, 75, 0.06);
    max-width: 40rem;
  }

  .reviews-page-hero__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .reviews-page-hero__g {
    font-size: 1.75rem;
    font-weight: 700;
    color: #4285f4;
  }

  .reviews-page-hero__stars {
    color: var(--gold);
    font-size: 0.8rem;
  }

  .reviews-page-hero__summary strong {
    display: block;
    font-size: 1.05rem;
    color: var(--deep);
  }

  .reviews-page-hero__summary span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .reviews-page-hero__profile {
    margin-left: auto;
    font-size: 0.8rem;
    padding: 0.7rem 1.1rem;
  }

  .reviews-page-list {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      #fff 0%,
      var(--panel) 18%,
      var(--panel) 100%
    );
  }

  .reviews-page-list__pattern {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      120deg,
      rgba(66, 133, 244, 0.03) 25%,
      transparent 25%,
      transparent 50%,
      rgba(66, 133, 244, 0.03) 50%,
      rgba(66, 133, 244, 0.03) 75%,
      transparent 75%,
      transparent
    );
    background-size: 30px 30px;
    opacity: 0.7;
    mask-image: linear-gradient(180deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
  }

  .reviews-page-list__inner {
    position: relative;
    z-index: 1;
  }

  .reviews-page-list__inner :global(.review-card) {
    border-color: rgba(19, 40, 75, 0.1);
    box-shadow:
      0 1px 2px rgba(19, 40, 75, 0.04),
      0 8px 20px rgba(19, 40, 75, 0.07);
  }

  .reviews-page-list__count {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    max-width: none;
  }

  .reviews-page-grid {
    column-count: 1;
    column-gap: 1.25rem;
  }

  .reviews-page-cell {
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    margin: 0 0 1.25rem;
  }

  .reviews-page-grid :global(.review-card) {
    width: auto;
  }

  .reviews-page-cta {
    margin-top: 3rem;
    padding: 2rem;
    text-align: center;
  }

  .reviews-page-cta h2 {
    color: var(--deep);
    margin-bottom: 0.5rem;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .reviews-page-cta p {
    color: var(--muted);
    margin: 0 auto 1.5rem;
    max-width: 42ch;
  }

  .reviews-page-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .reviews-page-grid {
      column-count: 2;
    }
  }

  @media (min-width: 1024px) {
    .reviews-page-grid {
      column-count: 3;
    }
  }

  @media (max-width: 640px) {
    .reviews-page-hero__profile {
      margin-left: 0;
      width: 100%;
    }

    .reviews-page-cta__actions .btn {
      width: 100%;
    }
  }
</style>
